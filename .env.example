# Copy to a protected file outside the repository. Never put real secrets here.
DESTINY_DATA_MODE=server
DESTINY_ACTIVITY_ID=meet
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55464/DATABASE
DESTINY_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DESTINY_PUBLIC_URL=https://YOUR_ACTIVITY_DOMAIN
DESTINY_OPERATOR_USERNAME=operator
# scrypt$32_HEX_SALT$128_HEX_HASH; do not place the plaintext password here.
DESTINY_OPERATOR_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
# Only for an explicitly isolated RFC1918 LAN HTTP validation instance.
DESTINY_ALLOW_LAN_HTTP=false
# Cloud container: verify server certificate; use a protected CA file if required.
DESTINY_DATABASE_SSL=verify-full
DESTINY_DATABASE_POOL_MAX=6
# DESTINY_DATABASE_CA_FILE=/run/secrets/postgres-ca.pem
# LOCAL PostgreSQL without TLS: set DESTINY_DATABASE_SSL=disable explicitly.
# Cloud test only: DATABASE name must end with _test; activity starts cloudtest-.
# DESTINY_CLOUD_TEST_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET

# Enable only after applying 002-private-services.sql and configuring agency login.
DESTINY_TONGZHOU_ENABLED=false
DESTINY_AVATARS_ENABLED=false
DESTINY_AGENCY_USERNAME=tongzhou
DESTINY_AGENCY_PASSWORD_HASH=REPLACE_WITH_INDEPENDENT_SCRYPT_HASH

# Mini program: disabled until AppID, AppSecret and migrations 003 through 013 are configured.
DESTINY_MINI_ENABLED=false
DESTINY_WECHAT_APPID=REPLACE_WITH_APPID
DESTINY_WECHAT_SECRET=REPLACE_WITH_SERVER_ONLY_APPSECRET
DESTINY_WECHAT_ENV_VERSION=trial
# Required for public mini login: enable ONLY a header overwritten by your trusted ingress.
# Never trust a client-supplied header. Keep the container reachable only through that ingress.
# DESTINY_TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# Apply database/007-member-wall.sql before enabling the optional card wall.
DESTINY_MEMBER_WALL_ENABLED=false

# Apply migrations through 013 before enabling independent registration / mini dual entry.
DESTINY_REGISTRATION_ENABLED=false
# Mini content review defaults to real WeChat; callback must use secure AES + JSON.
# Keep these values in protected server configuration, never in the miniapp bundle.
DESTINY_MINI_MODERATION=wechat
DESTINY_WECHAT_CALLBACK_TOKEN=
DESTINY_WECHAT_CALLBACK_AES_KEY=
