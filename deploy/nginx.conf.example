# Place log_format in the nginx http block. Query strings and credentials are excluded.
log_format destiny_safe '$remote_addr $request_method $uri $status $body_bytes_sent';
server {
    listen 443 ssl;
    server_name YOUR_ACTIVITY_DOMAIN;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    access_log /var/log/nginx/destinylab.log destiny_safe;
    client_max_body_size 11m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite user-supplied headers; only this proxy may reach port 8080.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
